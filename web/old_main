const elUploadBtn  = document.getElementById("uploadBtn");
const elFilelog = document.getElementById("filelog");

// ---------- Map preview refs ----------
const elCanvas  = document.getElementById("mapCanvas");
const elMapInfo = document.getElementById("mapInfo");
const ctx       = elCanvas.getContext("2d");
let tilesetMeta = { tilesetUrl:null, tileWidth:16, tileHeight:16, spaceX:1, spaceY:1 };
let tilesetImg  = null;

// ---------- Markdown setup ----------
marked.setOptions({
  breaks: true, gfm: true,
  highlight: (code, lang) => { try { return hljs.highlight(code, {language: lang}).value; } catch { return hljs.highlightAuto(code).value; } }
});
function renderResponse(text) {
  const clean = DOMPurify.sanitize(text ?? "");
  elPreview.innerHTML = marked.parse(clean);
  elRaw.value = text ?? "";
  document.querySelectorAll("pre code").forEach(b => hljs.highlightElement(b));
}
function setTab(which) {
  if (which === "raw") { elRaw.style.display="block"; elPreview.style.display="none"; elTabRaw.classList.add("active"); elTabPrev.classList.remove("active"); }
  else { elRaw.style.display="none"; elPreview.style.display="block"; elTabPrev.classList.add("active"); elTabRaw.classList.remove("active"); }
}
elTabPrev.onclick = () => setTab("preview");
elTabRaw.onclick  = () => setTab("raw");
elCopy.onclick    = async () => { try { await navigator.clipboard.writeText(elRaw.value || elPreview.innerText || ""); elStatus.textContent="Copied!"; } catch { elStatus.textContent="Copy failed"; } setTimeout(()=>elStatus.textContent="Ready.", 1200); };

// ---------- Tileset loader ----------
async function ensureTilesetLoaded() {
  if (tilesetImg && tilesetMeta.tilesetUrl) return true;
  const r = await fetch(`/api/memory/tileset-meta?projectId=${encodeURIComponent(projectId)}`);
  const data = await r.json();
  if (!data.ok || !data.tilesetUrl) { elMapInfo.textContent = "No tileset found. Ingest or upload one first."; return false; }
  tilesetMeta = data;
  await new Promise((resolve, reject) => {
    const img = new Image();
    img.crossOrigin = "anonymous";
    img.onload = () => { tilesetImg = img; resolve(); };
    img.onerror = reject;
    img.src = data.tilesetUrl;
  });
  return true;
}

// ---------- Map rendering ----------
function drawMap(map) {
  // resize canvas to grid size
  const pxW = map.width * tilesetMeta.tileWidth;
  const pxH = map.height * tilesetMeta.tileHeight;
  elCanvas.width = pxW; elCanvas.height = pxH;

  // background checker
  for (let y=0;y<map.height;y++){
    for (let x=0;x<map.width;x++){
      ctx.fillStyle = ((x+y)%2===0) ? "#ffffff" : "#f4f4f5";
      ctx.fillRect(x*tilesetMeta.tileWidth, y*tilesetMeta.tileHeight, tilesetMeta.tileWidth, tilesetMeta.tileHeight);
    }
  }

  if (!tilesetImg) { elMapInfo.textContent = "Tileset not loaded."; return; }

  for (const t of map.tiles) {
    const sx = t.col * (tilesetMeta.tileWidth + tilesetMeta.spaceX);
    const sy = t.row * (tilesetMeta.tileHeight + tilesetMeta.spaceY);
    const dx = t.x   * tilesetMeta.tileWidth;
    const dy = t.y   * tilesetMeta.tileHeight;
    ctx.drawImage(tilesetImg, sx, sy, tilesetMeta.tileWidth, tilesetMeta.tileHeight, dx, dy, tilesetMeta.tileWidth, tilesetMeta.tileHeight);
  }

  elMapInfo.textContent = `Rendered ${map.tiles.length} tiles on ${map.width}×${map.height} grid.`;
}

// ---------- Parse map JSON from assistant reply ----------
function extractTilemap(text) {
  if (!text) return null;

  // 1) Prefer ```tilemap ... ```
  let m = text.match(/```tilemap\s*([\s\S]*?)\s*```/i);
  let jsonStr = m ? m[1] : null;

  // 2) Fallback: any fenced block labeled json
  if (!jsonStr) {
    m = text.match(/```json\s*([\s\S]*?)\s*```/i);
    if (m) jsonStr = m[1];
  }

  // 3) Last resort: first top-level {...}
  if (!jsonStr) {
    m = text.match(/\{[\s\S]*\}/);
    if (m) jsonStr = m[0];
  }
  if (!jsonStr) return null;

  // --- sanitize JSON-ish to real JSON ---
  let s = jsonStr;

  // remove /* block comments */
  s = s.replace(/\/\*[\s\S]*?\*\//g, "");
  // remove // line comments (but not http://)
  s = s.replace(/(^|[^:])\/\/.*$/gm, "$1");
  // remove trailing commas before } or ]
  s = s.replace(/,(\s*[}\]])/g, "$1");
  // trim
  s = s.trim();

  try {
    const data = JSON.parse(s);
    if (
      typeof data.width === "number" &&
      typeof data.height === "number" &&
      Array.isArray(data.tiles)
    ) {
      return data;
    }
  } catch {
    // ignore; we'll return null below
  }
  return null;
}


// ---------- Chat send (single input drives everything) ----------
elSend.onclick = async () => {
  const text = elText.value.trim(); if (!text) return;
  elStatus.textContent = "Sending…";
  elText.value = "";
  try {
    const r = await fetch("/api/chat", {
      method: "POST",
      headers: { "Content-Type":"application/json" },
      body: JSON.stringify({ projectId, userText: text })
    });
    const data = await r.json();
    const reply = data.text || "(no response)";
    renderResponse(reply);
    elStatus.textContent = "Done.";

    // try to find a tilemap in the reply
    const map = extractTilemap(reply);
    if (map) {
      const ok = await ensureTilesetLoaded();
      if (ok) drawMap(map);
    }
  } catch (e) {
    renderResponse("**Error:** " + e);
    elStatus.textContent = "Error.";
  }
};

// Send + image still uses same chat box
elSendImg.onclick = async () => {
  const text = elText.value.trim();
  if (!text && (!elImg.files || elImg.files.length===0)) return;
  elStatus.textContent = "Uploading…";
  const form = new FormData();
  form.append("projectId", projectId);
  form.append("userText", text || "");
  if (elImg.files[0]) form.append("image", elImg.files[0]);
  elText.value = ""; elImg.value = "";
  try {
    const r = await fetch("/api/chat-with-image", { method: "POST", body: form });
    const data = await r.json();
    const reply = data.text || "(no response)";
    renderResponse(reply);
    elStatus.textContent = "Done.";

    const map = extractTilemap(reply);
    if (map) {
      const ok = await ensureTilesetLoaded();
      if (ok) drawMap(map);
    }
  } catch (e) {
    renderResponse("**Error:** " + e);
    elStatus.textContent = "Error.";
  }
};

// ===== Map Generator (prompt -> JSON -> canvas) =====
const elMapPrompt = document.getElementById("mapPrompt");
const elLoadTs    = document.getElementById("loadTileset");
const elGenMap    = document.getElementById("genMap");

async function ensureTilesetLoaded() {
  const r = await fetch(`/api/memory/tileset-meta?projectId=${encodeURIComponent(projectId)}`);
  const data = await r.json();
  if (!data.ok || !data.tilesetUrl) {
    elMapInfo.textContent = "No tileset found. Ingest or upload one first.";
    return false;
  }
  tilesetMeta = data;
  await new Promise((resolve, reject) => {
    const img = new Image();
    img.crossOrigin = "anonymous";
    img.onload = () => { tilesetImg = img; resolve(); };
    img.onerror = reject;
    img.src = data.tilesetUrl;
  });
  return true;
}

function drawMap(map) {
  const pxW = map.width * tilesetMeta.tileWidth;
  const pxH = map.height * tilesetMeta.tileHeight;
  elCanvas.width = pxW; elCanvas.height = pxH;

  // checker background
  for (let y=0; y<map.height; y++) {
    for (let x=0; x<map.width; x++) {
      ctx.fillStyle = ((x+y)%2===0) ? "#ffffff" : "#f4f4f5";
      ctx.fillRect(x*tilesetMeta.tileWidth, y*tilesetMeta.tileHeight, tilesetMeta.tileWidth, tilesetMeta.tileHeight);
    }
  }

  if (!tilesetImg) { elMapInfo.textContent = "Tileset not loaded."; return; }

  for (const t of map.tiles) {
    const sx = t.col * (tilesetMeta.tileWidth + tilesetMeta.spaceX);
    const sy = t.row * (tilesetMeta.tileHeight + tilesetMeta.spaceY);
    const dx = t.x   * tilesetMeta.tileWidth;
    const dy = t.y   * tilesetMeta.tileHeight;
    ctx.drawImage(tilesetImg, sx, sy, tilesetMeta.tileWidth, tilesetMeta.tileHeight, dx, dy, tilesetMeta.tileWidth, tilesetMeta.tileHeight);
  }

  elMapInfo.textContent = `Rendered ${map.tiles.length} tiles on ${map.width}×${map.height} grid.`;
}

elLoadTs.onclick = async () => {
  const ok = await ensureTilesetLoaded();
  if (ok) elMapInfo.textContent = "Tileset loaded.";
};

elGenMap.onclick = async () => {
  const prompt = (elMapPrompt.value || "").trim();
  if (!prompt) { elMapInfo.textContent = "Enter a map prompt."; return; }

  try {
    // ask backend to convert prompt -> strict JSON
    const r = await fetch("/api/map/generate", {
      method: "POST",
      headers: { "Content-Type":"application/json" },
      body: JSON.stringify({ projectId, prompt })
    });
    const data = await r.json();
    if (!data.ok) { elMapInfo.textContent = data.error || "Failed to generate map."; return; }

    const ok = await ensureTilesetLoaded();
    if (ok) drawMap(data.map);
  } catch (e) {
    elMapInfo.textContent = "Error: " + e.message;
  }
};


